# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL — required for dev and tests)
DATABASE_URL=postgres://lms:lms_dev_password@localhost:5432/lms

# Redis (Celery and cache — wired in later phases)
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible — wired in later phases)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Optional monitoring
SENTRY_DSN=
